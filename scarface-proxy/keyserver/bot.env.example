# Copy to bot.env and fill in. Never share or commit bot.env.

# Bot token: Discord Developer Portal > your application > Bot > Reset Token
DISCORD_TOKEN=

# Your server's id (Developer Mode on, right-click the server > Copy Server ID)
GUILD_ID=

# Optional: roles that may use /key commands, comma separated.
# Empty: only members with the Administrator permission.
ADMIN_ROLE_IDS=

# Optional: channel that gets a line for every key handed out or changed (never the full key)
LOG_CHANNEL_ID=

# Optional: channel where /guncelleduyur posts the "new exe" announcement.
# Empty: the announcement is posted to whatever channel you run the command in.
ANNOUNCE_CHANNEL_ID=

# Optional: banner image shown in the /guncelleduyur announcement (a direct image URL).
BANNER_URL=

# Days between self-service /hwid-sifirla per key (0 = no limit)
HWID_RESET_COOLDOWN_DAYS=7
